{
  "name": "dua-zikr-backend-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Dua & Zikr API v2 (Fastify + MySQL) with a small admin panel",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:setup": "tsx src/migrate.ts && tsx src/seed.ts",
    "seed:build": "tsx scripts/build-seed.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.7",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
