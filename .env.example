# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
# Public base URL of this server
PUBLIC_URL=http://localhost:8000
# Set to true only when running behind a reverse proxy (nginx, Caddy, Cloudflare)
TRUST_PROXY=false

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dua_zikr
DB_PASSWORD=change-me
DB_NAME=dua_zikr_v2

# Admin panel login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string, at least 32 characters (signs the admin session cookie)
SESSION_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Comma-separated origins allowed for browser CORS (mobile apps don't need this)
CORS_ORIGINS=http://localhost:8000
